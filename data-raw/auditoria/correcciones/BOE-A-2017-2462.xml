          <td>
            <p class="cabeza_tabla">Cuerpo</p>
          </td>
          <td>
            <p class="cabeza_tabla">Haber regulador</p>
            <p class="cabeza_tabla">– </p>
            <p class="cabeza_tabla">Euros/año</p>
          </td>
        </tr>
      </thead>
      <tbody>
        <tr class="row_column_4">
          <td>
            <p class="cuerpo_tabla_izq">Secretario General	</p>
          </td>
          <td>
            <p class="cuerpo_tabla_der">1.631,85</p>
          </td>
        </tr>
        <tr class="row_column_5">
          <td>
            <p class="cuerpo_tabla_izq">De Letrados	</p>
          </td>
          <td>
            <p class="cuerpo_tabla_der">1.631,85</p>
          </td>
        </tr>
        <tr class="row_column_4">
          <td>
            <p class="cuerpo_tabla_izq">Gerente	</p>
          </td>
          <td>
            <p class="cuerpo_tabla_der">1.631,85»</p>
          </td>
        </tr>
      </tbody>
    </table>
    <p xmlns:xhtml="http://www.w3.org/1999/xhtml" class="parrafo_2">debe decir:</p>
    <p xmlns:xhtml="http://www.w3.org/1999/xhtml" class="centro_redonda">«TRIBUNAL CONSTITUCIONAL</p>
